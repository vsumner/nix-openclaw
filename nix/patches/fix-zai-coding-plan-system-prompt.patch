@@ -0,0 +1,82 @@
+import type { ProviderPlugin } from "openclaw/plugin-sdk/plugin-entry";
+import {
+  normalizeLowercaseStringOrEmpty,
+  normalizeOptionalString,
+} from "openclaw/plugin-sdk/string-coerce-runtime";
+
+type ProviderTransformSystemPromptContext = Parameters<
+  NonNullable<ProviderPlugin["transformSystemPrompt"]>
+>[0];
+
+// Z.AI Coding Plan returns HTTP 429/code 1305 when the final system prompt
+// contains this exact case-sensitive identity line. Keep the rewrite narrow:
+// only Coding Plan routes and only the measured blocked substring.
+const ZAI_CODING_BLOCKED_PROMPT_SUBSTRING =
+  "You are a personal assistant running inside OpenClaw";
+const ZAI_CODING_PROMPT_REPLACEMENT =
+  "You are a personal assistant running within OpenClaw";
+const ZAI_CODING_PATH_MARKER = "/api/coding/";
+
+function isZaiCodingBaseUrl(baseUrl: unknown): boolean {
+  const normalized = normalizeOptionalString(baseUrl);
+  if (!normalized) {
+    return false;
+  }
+  try {
+    return new URL(normalized).pathname.includes(ZAI_CODING_PATH_MARKER);
+  } catch {
+    return normalized.includes(ZAI_CODING_PATH_MARKER);
+  }
+}
+
+function resolveConfiguredProvider(ctx: ProviderTransformSystemPromptContext) {
+  const providers = ctx.config?.models?.providers;
+  if (!providers) {
+    return undefined;
+  }
+  const exact = providers[ctx.provider];
+  if (exact) {
+    return exact;
+  }
+  const normalizedProvider = normalizeLowercaseStringOrEmpty(ctx.provider);
+  for (const [key, value] of Object.entries(providers)) {
+    if (normalizeLowercaseStringOrEmpty(key) === normalizedProvider) {
+      return value;
+    }
+  }
+  return undefined;
+}
+
+function matchesConfiguredModelId(candidateId: unknown, provider: string, modelId: string): boolean {
+  if (typeof candidateId !== "string") {
+    return false;
+  }
+  if (candidateId === modelId) {
+    return true;
+  }
+  const slashIndex = candidateId.indexOf("/");
+  return (
+    slashIndex > 0 &&
+    candidateId.slice(slashIndex + 1) === modelId &&
+    normalizeLowercaseStringOrEmpty(candidateId.slice(0, slashIndex)) ===
+      normalizeLowercaseStringOrEmpty(provider)
+  );
+}
+
+export function transformZaiCodingSystemPrompt(
+  ctx: ProviderTransformSystemPromptContext,
+): string | undefined {
+  const providerConfig = resolveConfiguredProvider(ctx);
+  const configuredModel = providerConfig?.models?.find((candidate) =>
+    matchesConfiguredModelId(candidate?.id, ctx.provider, ctx.modelId),
+  );
+  if (!isZaiCodingBaseUrl(configuredModel?.baseUrl ?? providerConfig?.baseUrl)) {
+    return undefined;
+  }
+  if (!ctx.systemPrompt.includes(ZAI_CODING_BLOCKED_PROMPT_SUBSTRING)) {
+    return undefined;
+  }
+  return ctx.systemPrompt
+    .split(ZAI_CODING_BLOCKED_PROMPT_SUBSTRING)
+    .join(ZAI_CODING_PROMPT_REPLACEMENT);
+}
