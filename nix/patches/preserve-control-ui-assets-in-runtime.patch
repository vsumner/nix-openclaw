+      expect(await fs.promises.readFile(path.join(runtimeDir, "index.css"), "utf8")).toBe(
+        "browser-style-body\\n",
+      );
+      expect(
+        await fs.promises.readFile(path.join(runtimeDir, "chunks", "vendor.js"), "utf8"),
+      ).toBe("browser-chunk-body\\n");
+      expect(fs.lstatSync(path.join(runtimeDir, "index.js")).isSymbolicLink()).toBe(false);
+      expect(fs.lstatSync(path.join(runtimeDir, "index.css")).isSymbolicLink()).toBe(false);
+      expect(
