diff --git a/scripts/stage-bundled-plugin-runtime.mts b/scripts/stage-bundled-plugin-runtime.mts
--- a/scripts/stage-bundled-plugin-runtime.mts
+++ b/scripts/stage-bundled-plugin-runtime.mts
@@ -243,6 +243,45 @@ function shouldCopyRuntimeFile(relativePath: string) {
   );
 }
 
+function controlUiAssetDirectory(
+  pluginDir: string,
+): { sourceDir: string; entryPath: string } | undefined {
+  const manifest = tryReadJsonFile(path.join(pluginDir, "openclaw.plugin.json"));
+  if (!isRecord(manifest) || !isRecord(manifest.controlUi)) {
+    return undefined;
+  }
+  const entry = manifest.controlUi.entry;
+  if (typeof entry !== "string" || entry.length === 0 || path.posix.isAbsolute(entry)) {
+    return undefined;
+  }
+  const directory = path.posix.dirname(entry);
+  if (directory === "." || directory.split("/").some((segment) => segment === "..")) {
+    return undefined;
+  }
+  const sourceDir = path.resolve(pluginDir, directory);
+  if (!sourceDir.startsWith(`${path.resolve(pluginDir)}${path.sep}`)) {
+    return undefined;
+  }
+  return { sourceDir, entryPath: path.join(pluginDir, entry) };
+}
+
+function copyDeclaredControlUiAssets(sourcePluginDir: string, targetPluginDir: string) {
+  const controlUi = controlUiAssetDirectory(sourcePluginDir);
+  if (!controlUi) {
+    return;
+  }
+  const { sourceDir, entryPath } = controlUi;
+  const targetDir = path.join(targetPluginDir, path.relative(sourcePluginDir, sourceDir));
+  if (!fs.existsSync(sourceDir) || !fs.statSync(sourceDir).isDirectory()) {
+    throw new Error(`declared Control UI directory is missing: ${sourceDir}`);
+  }
+  if (!fs.existsSync(entryPath) || !fs.statSync(entryPath).isFile()) {
+    throw new Error(`declared Control UI entry is missing: ${entryPath}`);
+  }
+  removePathIfExists(targetDir);
+  fs.cpSync(sourceDir, targetDir, { recursive: true, dereference: false, verbatimSymlinks: true });
+}
+
 function hasDefaultExport(sourcePath: string) {
   const text = fs.readFileSync(sourcePath, "utf8");
   return /\bexport\s+default\b/u.test(text) || /\bas\s+default\b/u.test(text);
@@ -357,6 +395,7 @@ export function stageBundledPluginRuntime(params: { cwd?: string; repoRoot?: st
     const runtimePluginDir = path.join(runtimeExtensionsRoot, dirent.name);
 
     stagePluginRuntimeOverlay(distPluginDir, runtimePluginDir);
+    copyDeclaredControlUiAssets(distPluginDir, runtimePluginDir);
   }
 }
 
