+
+  it("copies the manifest-declared Control UI directory byte-for-byte", async () => {
+    await withTempDir(async (repoRoot) => {
+      const pluginDir = path.join(repoRoot, "dist", "extensions", "workboard");
+      const assetDir = path.join(pluginDir, "dist", "control-ui", "build");
+      const entryPath = path.join(assetDir, "index.js");
+      const stylePath = path.join(assetDir, "index.css");
+      const chunkPath = path.join(assetDir, "chunks", "vendor.js");
+      await fs.promises.mkdir(assetDir, { recursive: true });
+      await fs.promises.writeFile(entryPath, "browser-entry-body\\n", "utf8");
+      await fs.promises.writeFile(stylePath, "browser-style-body\\n", "utf8");
+      await fs.promises.mkdir(path.dirname(chunkPath), { recursive: true });
+      await fs.promises.writeFile(chunkPath, "browser-chunk-body\\n", "utf8");
+      await fs.promises.writeFile(
+        path.join(pluginDir, "openclaw.plugin.json"),
+        JSON.stringify({
+          id: "workboard",
+          controlUi: {
+            entry: "dist/control-ui/build/index.js",
+            styles: ["dist/control-ui/build/index.css"],
+          },
+        }),
+        "utf8",
+      );
+
+      stageBundledPluginRuntime({ repoRoot });
+
+      const runtimeDir = path.join(
+        repoRoot,
+        "dist-runtime",
+        "extensions",
+        "workboard",
+        "dist",
+        "control-ui",
+        "build",
+      );
+      expect(await fs.promises.readFile(path.join(runtimeDir, "index.js"), "utf8")).toBe(
+        "browser-entry-body\\n",
