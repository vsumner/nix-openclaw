+      expect(await fs.promises.readFile(entryPath, "utf8")).toBe("browser-entry-body\\n");
+      expect(await fs.promises.readFile(stylePath, "utf8")).toBe("browser-style-body\\n");
+      expect(await fs.promises.readFile(chunkPath, "utf8")).toBe("browser-chunk-body\\n");
